<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /precios/

  # No reescribir archivos estáticos ni la API PHP
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA: /precios/checkout, /precios/confirmacion, etc.
  RewriteRule ^ index.html [L]
</IfModule>

# Copiar a .env.local para desarrollo (Create React App)
# No commitear archivos .env con valores reales.

# Openpay (solo llave pública en el frontend; privada va en el servidor)
REACT_APP_OPENPAY_PUBLIC_KEY=

# Webhook / backend (servidor PHP, no en el bundle de React)
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_PUBLIC_KEY=
CONEKTA_WEBHOOK_SECRET=

# Base de datos membresías (servidor)
MEMBERSHIP_DB_HOST=
MEMBERSHIP_DB_NAME=
MEMBERSHIP_DB_USER=
MEMBERSHIP_DB_PASSWORD=
